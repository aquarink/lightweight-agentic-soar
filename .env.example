# Environment Configuration for Lightweight Agentic SOAR
# Copy this file to .env and adjust values for your deployment environment

SOAR_PORT=8080
OLLAMA_URL=http://localhost:11434/api/generate
# Lightweight Model Options: qwen2.5-coder:1.5b (recommended, ~4-5s) or gemma3:1b (~5-8s)
SOAR_AI_MODEL=qwen2.5-coder:1.5b
SOAR_ADMIN_USER=admin
SOAR_ADMIN_PASS=your-secure-password
SOAR_WHITELISTED_IPS=127.0.0.1
DEFAULT_TTL=86400
# ArusBalik Edge Gateway SSH for IPset Synchronization (Optional)
ARUSBALIK_SSH_HOST=10.88.0.1
ARUSBALIK_SSH_USER=root
ARUSBALIK_SSH_PASS=your-edge-ssh-password
